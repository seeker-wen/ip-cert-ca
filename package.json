{
  "name": "ip-cert-ca",
  "version": "1.0.0",
  "description": "A lightweight Certificate Authority for generating SSL certificates for IP addresses in intranet environments",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prod": "pm2 start ./src/main.js --name ip-cert-ca",
    "start": "node ./src/main.js"
  },
  "bin": {
    "ip-cert-ca": "./src/main.js"
  },
  "keywords": [
    "certificate-authority",
    "ssl-certificate",
    "ip-certificate",
    "intranet",
    "https",
    "ca",
    "node-forge",
    "internal-ca",
    "private-ca",
    "self-signed",
    "certificate-management",
    "enterprise"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/seeker-wen/ip-cert-ca.git"
  },
  "homepage": "https://github.com/seeker-wen/ip-cert-ca#readme",
  "bugs": {
    "url": "https://github.com/seeker-wen/ip-cert-ca/issues"
  },
  "engines": {
    "node": ">=18.17.1"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "pm2": "^6.0.13",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  }
}